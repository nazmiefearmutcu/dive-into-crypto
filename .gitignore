# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
*.egg

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- macOS runtime outputs ---
# Ignore everything in runtime/ by default (logs, pid, future files)…
macOS/runtime/*
# …then allow analysis snapshots back in:
!macOS/runtime/*.json
!macOS/runtime/active_symbol.txt
!macOS/runtime/auto_scan_disabled
!macOS/runtime/auto_select_disabled

# --- Windows build artifacts (PyInstaller) ---
windows/build/
windows/dist/
windows/packaging/build/
windows/packaging/dist/
windows/launcher/build/
windows/launcher/dist/

# --- Environment files (must never be committed) ---
.env
.env.local
*.local.env

# --- Logs ---
*.log
