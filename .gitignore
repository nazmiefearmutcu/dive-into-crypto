# ── Desktop edition ──
# NOTE: desktop/ui/dist/ IS committed (prebuilt bundle) so the app runs with no Node.
# The backend serves it directly (api/app.py → _UI_DIST), so it is a runtime artefact,
# not a build leftover. Rebuild with `cd desktop/ui && npm run build` after editing src/.
desktop/ui/node_modules/
desktop/ui/test/.tmp/
desktop/backend/.venv/
desktop/backend/data/

# Python cache files
**/__pycache__/
**/*.pyc
*.pyc

# Agents — working notes carry local machine paths; never publish.
.agents/
docs/superpowers/
.superpowers/

