# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
*.egg

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- macOS runtime outputs ---
# Runtime/ is live process state (PID, scan progress, balances, flags) — never
# source-truth. Ignore everything inside it except the .gitkeep placeholder so
# the directory continues to exist after a clean checkout.
# Historical incident snapshots live under macOS/tests/fixtures/runtime_snapshots/
# and are tracked normally.
macOS/runtime/*
!macOS/runtime/.gitkeep

# --- Windows build artifacts (PyInstaller) ---
windows/build/
windows/dist/
windows/packaging/build/
windows/packaging/dist/
windows/launcher/build/
windows/launcher/dist/

# --- Environment files (must never be committed) ---
.env
.env.local
*.local.env

# --- Logs ---
*.log
