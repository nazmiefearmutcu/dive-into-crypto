* text=auto
gradlew text eol=lf
*.bat text eol=crlf
*.png binary
*.jar binary
*.apk binary

# The UI build (esbuild concat + verbatim copies) is byte-sensitive: dist/ is a
# committed runtime artefact and the CI drift gate compares it to a fresh build,
# so the whole desktop/ui tree is pinned to LF on every platform.
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.py text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
