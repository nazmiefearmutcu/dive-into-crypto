<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Startup theme for the window. Edge-to-edge is enforced on targetSdk 36, so the
      status/nav bar colours are NOT set here (android:statusBarColor and
      navigationBarColor are ignored on Android 15+). The bars are transparent and
      the top/bottom bar composables paint their own surfaces behind the system bars.
      MainActivity keeps the light/dark icon appearance in step with the active preset.
      windowBackground is the pre-first-frame colour (TERMINAL · Phosphor default).
    -->
    <style name="Theme.DiveIntoCrypto" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">@color/dive_bg</item>
    </style>
</resources>
